#! /usr/bin/env sh

should_run_ingestion_services() {
  # If OPENF1_ENABLE_RACE_WINDOW_ONLY is set to "true", only run during race windows
  if [ "$OPENF1_ENABLE_RACE_WINDOW_ONLY" != "true" ]; then
    return 0
  fi

  HOURS_BEFORE=${OPENF1_RACE_WINDOW_HOURS_BEFORE:-12}
  HOURS_AFTER=${OPENF1_RACE_WINDOW_HOURS_AFTER:-12}

  python - "$HOURS_BEFORE" "$HOURS_AFTER" <<'PYCODE'
import sys
from openf1.util.race_scheduler import is_race_window

hours_before = int(sys.argv[1])
hours_after = int(sys.argv[2])

# This will log the window status with timing details
in_window = is_race_window(hours_before=hours_before, hours_after=hours_after)
sys.exit(0 if in_window else 1)
PYCODE
  
  return $?
}

run_role() {
  role="$1"
  case "$role" in
    api)
      echo "Starting api"
      uvicorn --host="0.0.0.0" openf1.services.query_api.app:app --reload
      ;;
    ingest-realtime)
      echo "Starting ingest-realtime"
      
      # Check if ingestion services should run during race windows only
      if ! should_run_ingestion_services; then
        echo "Not in race window and OPENF1_ENABLE_RACE_WINDOW_ONLY=true; will retry in 1 hour"
        sleep 3600
        exec "$0" ingest-realtime
      fi
      
      sleep 2
      python -m openf1.services.ingestor_livetiming.real_time.app
      ;;
    ingest-historical)
      echo "Starting ingest-historical"
      
      # Check if ingestion services should run during race windows only
      if ! should_run_ingestion_services; then
        echo "Not in race window and OPENF1_ENABLE_RACE_WINDOW_ONLY=true; will retry in 1 hour"
        sleep 3600
        exec "$0" ingest-historical
      fi
      
      # Historical ingestion only runs on deploy when explicitly enabled.
      if [ "$OPENF1_RUN_HISTORICAL_ON_DEPLOY" != "true" ]; then
        echo "ingest-historical present in ROLE but OPENF1_RUN_HISTORICAL_ON_DEPLOY!=true; skipping historical ingest"
      fi

      # If OPENF1_DROP_DB_ON_DEPLOY is set to "true", drop the database first
      if [ "$OPENF1_DROP_DB_ON_DEPLOY" = "true" ]; then
        echo "Dropping MongoDB database $OPENF1_DB_NAME (if set)"
        python - <<PYCODE
from openf1.util.db import _get_mongo_client_sync, _MONGO_DATABASE
client = _get_mongo_client_sync()
db_name = "$OPENF1_DB_NAME" if "$OPENF1_DB_NAME" != "" else _MONGO_DATABASE
client.drop_database(db_name)
print(f"Dropped database: {db_name}")
PYCODE
      fi

      # Use OPENF1_INGEST_HISTORICAL_YEARS if set, otherwise default to current year
      YEARS=${OPENF1_INGEST_HISTORICAL_YEARS:-$(date +"%Y")}
      echo "Running historical ingestion for years: $YEARS"
      python -m openf1.scripts.ingest_all_no_cardata --years $YEARS --skip-existing
      # Keep running the historical ingestion every 2 1/2 minutes so the container
      # continuously updates with new data. This loop runs until the container stops.
      echo "Entering scheduled loop: ingest historical data every 2 1/2 minutes"
      while true; do
        # Check if we're still in race window
        if ! should_run_ingestion_services; then
          echo "Exiting race window; pausing historical ingestion..."
          sleep 3600
          # Re-check periodically
          continue
        fi
        python -m openf1.scripts.ingest_all_no_cardata --years $YEARS --skip-existing
        sleep 150
      done
      ;;
    scrape-latest)
      echo "Starting scrape-latest"
      
      # Check if ingestion services should run during race windows only
      if ! should_run_ingestion_services; then
        echo "Not in race window and OPENF1_ENABLE_RACE_WINDOW_ONLY=true; will retry in 1 hour"
        sleep 3600
        exec "$0" scrape-latest
      fi
      
      # Force scrapers to call the local api when running in the same container
      export OPENF1_BASE_URL=http://localhost:8000
      echo "OPENF1_BASE_URL set to $OPENF1_BASE_URL"
      # Wait up to ~30s for the local API to start responding
      python - <<'PY'
import sys, time, urllib.request
url = "http://localhost:8000/"
print(f"Waiting for local API at {url} (30s timeout)...")
for i in range(30):
    try:
        r = urllib.request.urlopen(url, timeout=2)
        if getattr(r, 'status', None) in (200, None):
            print('Local API is responding')
            sys.exit(0)
    except Exception:
        time.sleep(1)
print('Timed out waiting for local API; continuing anyway')
sys.exit(0)
PY
      python -m openf1.services.f1_scraping.schedule ingest-meetings
      python -m openf1.services.f1_scraping.schedule ingest-sessions
        # Run scrapers for all sessions in the given years. Use OPENF1_INGEST_SCRAPER_YEARS if set,
        # otherwise default to the current year.
        YEARS=${OPENF1_INGEST_SCRAPER_YEARS:-$(date +"%Y")}
        echo "Running scraper ingestion for years: $YEARS"
        python -m openf1.scripts.ingest_scrapers --years $YEARS
        # If we are in scrape-latest mode for deployment, afterwards keep running the
        # latest-session scraper every 2 1/2 minutes so the container ingests new results
        # automatically. This loop runs until the container stops.
        echo "Entering scheduled loop: ingest latest session every 2 1/2 minutes"
        while true; do
          # Check if we're still in race window
          if ! should_run_ingestion_services; then
            echo "Exiting race window; pausing scraper loop..."
            sleep 3600
            # Re-check periodically
            continue
          fi
          # Run latest session ingestion (no args => scrape latest)
          python -m openf1.scripts.ingest_scrapers
          sleep 150
        done
      ;;
    *)
      echo "\"$role\" not recognized, please set a valid role"
      exit 1
      ;;
  esac
}

# Allow comma-separated ROLE values so a single container can run multiple roles
if echo "$ROLE" | grep -q ','; then
  IFS=','; set -- $ROLE
  PIDS=""
  for r in "$@"; do
    # Trim possible whitespace (require no spaces ideally)
    role_cleaned="$r"
    run_role "$role_cleaned" &
    PIDS="$PIDS $!"
  done
  # Wait for all background processes
  wait
else
  run_role "$ROLE"
fi
